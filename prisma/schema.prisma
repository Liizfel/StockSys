generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  ATTENDANT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ATTENDANT)
  createdAt DateTime @default(now()) @map("created_at")

  // Relacionamento com Setor (Setor Principal)
  sectorId  String?      @map("sector_id")
  sector    Sector?      @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  // Setores adicionais separados por vírgula (permite múltiplos setores)
  additionalSectors String? @default("") @map("additional_sectors")

  // Históricos e Logs vinculados ao usuário
  timeLogs  TimeLog[]
  counts    StockCount[]
  audits    AuditLog[]

  @@map("users")
}

model Sector {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  materials Material[]
  users     User[]

  @@map("sectors")
}

model Supplier {
  id        String     @id @default(uuid())
  name      String     @unique
  phone     String?
  email     String?
  createdAt DateTime   @default(now()) @map("created_at")
  materials Material[]

  @@map("suppliers")
}

model Material {
  id                   String       @id @default(uuid())
  code                 String       @unique
  codigoBarras         String?      @unique @map("codigo_barras")
  name                 String
  quantity             Float        @default(0)
  estoqueMinimo        Float        @default(0) @map("estoque_minimo")
  unit                 String       @default("UN")
  imageUrl             String?      @map("image_url")
  supplierDeliveryDays Int          @default(0) @map("supplier_delivery_days")
  origin               String       @default("Nacional")
  status               String       @default("Pendente") // "Pendente", "Contado", "Divergente"
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  sectorId   String?  @map("sector_id")
  sector     Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  supplierId String?  @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  counts StockCount[]
  audits AuditLog[]

  @@map("materials")
}

model StockCount {
  id          String   @id @default(uuid())
  materialId  String   @map("material_id")
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldQuantity Float    @map("old_quantity")
  newQuantity Float    @map("new_quantity")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("stock_counts")
}

model TimeLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now()) @map("login_at")
  logoutAt  DateTime? @map("logout_at")

  @@map("time_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId  String   @map("material_id")
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  action      String   // "CREATE", "UPDATE", "DELETE", "COUNT", "STATUS_CHANGE"
  details     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}