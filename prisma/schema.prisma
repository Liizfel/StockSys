generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(uuid())
  name      String
  email     String       @unique
  password  String // Em produção, use sempre hash (bcrypt/argon2)
  role      String // 'MANAGER' ou 'ATTENDANT'
  createdAt DateTime     @default(now()) @map("created_at")
  
  // Relacionamento com Setor (Chave Estrangeira)
  sectorId  String?      @map("sector_id")
  sector    Sector?      @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  // Setores adicionais separados por vírgula
  additionalSectors String? @default("") @map("additional_sectors")

  // Históricos e Logs vinculados ao usuário
  timeLogs  TimeLog[]
  counts    StockCount[]

  @@map("users")
}

model Sector {
  id        String     @id @default(uuid())
  name      String     @unique
  
  // Relações inversas do Prisma
  materials Material[]
  users     User[]

  @@map("sectors")
}

model Material {
  id            String       @id @default(uuid())
  code          String       @unique
  codigoBarras  String?      @map("codigo_barras")
  name          String
  quantity      Int          @default(0)
  estoqueMinimo Int          @default(5) @map("estoque_minimo")
  status        String       @default("PENDING") // 'PENDING', 'COUNTED_RECENTLY', 'AWAITING_CONFIRMATION', 'PURCHASE_REQUESTED', 'COMPLETED'
  notes         String?
  unit          String?      @default("un")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relacionamento com Setor (Chave Estrangeira)
  sectorId      String       @map("sector_id")
  sector        Sector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  // Relacionamento com Fornecedor (Chave Estrangeira)
  supplierId    String?      @map("supplier_id")
  supplier      Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  supplierDeliveryDays Int?  @map("supplier_delivery_days")
  dailyUsage           Int?  @map("daily_usage")
  origin               String?
  requestedQuantity    Int?      @default(0) @map("requested_quantity")
  repostedAt           DateTime? @map("reposted_at")
  imageUrl             String?   @map("image_url")
  isGiro               Boolean   @default(false) @map("is_giro")

  // Localização física do material
  area                 String?
  estante              String?
  prateleira           String?
  palete               String?
  paleteQty            Int?      @map("palete_qty")

  // Setores adicionais separados por vírgula
  additionalSectors    String?   @default("") @map("additional_sectors")

  // Histórico de contagens deste material
  counts        StockCount[]

  @@map("materials")
}

model StockCount {
  id               String   @id @default(uuid())
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  timestamp        DateTime @default(now())
  notes            String?

  // Relacionamento com Material
  materialId       String   @map("material_id")
  material         Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // Relacionamento com Usuário (Quem contou)
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("stock_counts")
}

model TimeLog {
  id        String   @id @default(uuid())
  type      String   // 'LOGIN' ou 'LOGOUT'
  timestamp DateTime @default(now())
  ipAddress String   @map("ip_address")

  // Relacionamento com Usuário
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_logs")
}

model Supplier {
  id           String     @id @default(uuid())
  name         String     @unique
  deliveryDays Int        @default(0) @map("delivery_days")
  materials    Material[]

  @@map("suppliers")
}

model Notification {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  type       String   // 'CRITICAL_STOCK' or 'PURCHASE_ALERT'
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
}