{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api).*\\..*)",
      "destination": "/dist/$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/dist/index.html"
    }
  ],
  "cleanUrls": true
}